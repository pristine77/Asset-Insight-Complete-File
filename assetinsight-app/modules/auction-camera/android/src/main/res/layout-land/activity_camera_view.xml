<include android:id="@+id/includePro" layout="@layout/item_pro_layout" android:layout_width="0dp" android:layout_height="wrap_content" android:elevation="20dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/bottomPanel" app:layout_constraintTop_toBottomOf="@id/includeMainExtra" />
