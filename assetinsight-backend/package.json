{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bootstrap": "vitest run tests/bootstrap-configuration.test.ts tests/application-composition.test.ts tests/report-worker-registry.test.ts",
    "test:device-security": "vitest run tests/device-access.integration.test.ts",
    "dev": "nodemon src/index.ts",
    "dev:worker": "TS_NODE_TRANSPILE_ONLY=true nodemon --watch src --ext ts --exec \"node --loader ts-node/esm src/reportWorker.ts\"",
    "build": "tsc",
    "typecheck": "tsc --noEmit --pretty false",
    "check": "npm run check:openai-client && npm run typecheck",
    "verify": "npm run check && npm test && npm run build",
    "start": "node dist/index.js",
    "worker": "node dist/reportWorker.js",
    "test:docx": "node --loader ts-node/esm src/scripts/generateSampleDocx.ts",
    "test:realestate": "node --loader ts-node/esm src/scripts/generateSampleRealEstateDocx.ts",
    "test:image": "node --loader ts-node/esm src/scripts/testImageProcessing.ts",
    "generate:asset-category-specs": "node scripts/generateAssetCategorySpecs.cjs",
    "check:openai-client": "node scripts/checkProviderClientBoundary.cjs",
    "check:report-workflow": "npm run build && node dist/scripts/checkReportWorkflow.js",
    "prebuild": "npm run generate:asset-category-specs && npm run check:openai-client",
    "sample:docx": "npm run build && node dist/scripts/generateSampleDocx.js",
    "sample:realestate": "npm run build && node dist/scripts/generateSampleRealEstateDocx.js",
    "seed:superadmin": "npm run build && node dist/scripts/seedSuperadmin.js",
    "migrate:approve-pending-lot-listings": "node dist/scripts/approvePendingLotListings.js",
    "migrate:auctioneer2-user-scope": "node dist/scripts/migrateAuctioneer2UserScope.js",
    "resync:auctioneer2-photos": "npm run build && node dist/scripts/resyncAuctioneer2Photos.js",
    "ensure:auctioneer2-indexes": "node dist/scripts/ensureAuctioneer2Indexes.js",
    "quiesce:backend": "pm2 stop ecosystem.config.cjs",
    "quiesce:auctioneer2-user-scope": "npm run quiesce:backend",
    "reconcile:report-processing": "node dist/scripts/reconcileReportProcessing.js",
    "backfill:asset-contract-keys": "npm run build && node dist/scripts/backfillAssetContractKeys.js",
    "migrate:device-approval": "npm run build && node dist/scripts/activateDeviceApproval.js",
    "support:developer-access": "node dist/scripts/manageSupportDeveloperAccess.js",
    "repair:crm-phones": "npm run build && node dist/scripts/repairCrmPhonePlaceholders.js",
    "migrate:report-draft-indexes": "node dist/scripts/migrateReportDraftIndexes.js",
    "deploy": "git pull --ff-only && npm ci --no-audit --no-fund && npm run build && npm run quiesce:backend && npm run ensure:auctioneer2-indexes && npm run migrate:report-draft-indexes && pm2 startOrReload ecosystem.config.cjs --update-env && npm run reconcile:report-processing && pm2 save",
    "deploy:with-migrations": "npm ci --no-audit --no-fund && npm run build && npm run quiesce:backend && npm run migrate:auctioneer2-user-scope && npm run migrate:approve-pending-lot-listings && npm run ensure:auctioneer2-indexes && pm2 startOrReload ecosystem.config.cjs --update-env && npm run reconcile:report-processing && pm2 save"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.893.0",
    "@aws-sdk/lib-storage": "3.893.0",
    "@aws-sdk/s3-request-presigner": "^3.1062.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "apple-signin-auth": "^2.0.0",
    "archiver": "^7.0.1",
    "axios": "^1.15.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.6",
    "csv-parse": "^6.1.0",
    "docx": "^9.6.1",
    "docx-templates": "^4.15.0",
    "docxtemplater": "^3.68.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "google-auth-library": "^10.6.2",
    "groupdocs-merger-cloud": "^23.10.0",
    "handlebars": "^4.7.9",
    "heic-convert": "^2.1.0",
    "heic-decode": "^2.1.0",
    "jimp": "^1.6.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "9.4.1",
    "multer": "^2.1.1",
    "openai": "^6.34.0",
    "passport": "^0.7.0",
    "passport-apple": "^2.0.2",
    "passport-google-oauth20": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "pizzip": "^3.2.0",
    "puppeteer": "24.41.0",
    "resend": "^6.1.3",
    "sharp": "^0.34.5",
    "sib-api-v3-sdk": "^8.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/html-to-docx": "^1.8.1",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.4.0",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@types/express-serve-static-core": "5.0.7",
    "axios": "$axios",
    "qs": "6.15.3"
  }
}
